              {
                "name": "employee_id",
                "value": "",
                "type": "query",
                "description": "Filter employments by employee ID."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List employment records including job titles, pay rates, pay periods, and employment type from the connected HRIS provider."
        }
      ]
    },
    {
      "info": {
