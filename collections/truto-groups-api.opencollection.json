                "description": "The ID of the integrated account (connected HRIS provider instance) to query. Required for all Unified API requests."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter groups by type (department, team, cost_center)."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List groups (departments, teams, cost centers) from the connected HRIS provider."
        }
      ]
    }
  ],
  "bundled": true
}