{
  "opencollection": "1.0.0",
  "info": {
    "name": "Truto Admin Accounts Groups API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.truto.one/groups",
            "params": [
              {
                "name": "integrated_account_id",
                "value": "",
