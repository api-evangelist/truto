                "name": "job_id",
                "value": "",
                "type": "query",
                "description": "Filter applications by job ID."
              },
              {
                "name": "candidate_id",
                "value": "",
                "type": "query",
                "description": "Filter applications by candidate ID."
              },
              {
                "name": "status",
                "value": "",
