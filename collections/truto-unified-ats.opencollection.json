          "info": {
            "name": "Get candidate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.truto.one/unified/ats/candidates/:id",
            "params": [
              {
                "name": "integrated_account_id",
                "value": "",
                "type": "query",
                "description": "The ID of the integrated account (connected ATS provider instance) to query. Required for all Unified API requests."
              },
